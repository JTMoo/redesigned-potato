# Google OAuth (create at console.developers.google.com)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# JWT signing secret (min 32 chars)
JWT_SECRET=YOUR_JWT_SECRET_MINIMUM_32_CHARACTERS_LONG

# PostgreSQL passwords
USER_DB_PASSWORD=postgres
RECEIPT_DB_PASSWORD=postgres
DEAL_DB_PASSWORD=postgres
MATCHING_DB_PASSWORD=postgres
AGGREGATION_DB_PASSWORD=postgres
NOTIFICATION_DB_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=receipts

# Seq
SEQ_ADMIN_PASSWORD=seqadmin
SEQ_API_KEY=
