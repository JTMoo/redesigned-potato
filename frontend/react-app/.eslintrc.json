{
  "extends": ["airbnb-typescript"],
  "plugins": ["react", "import", "jsx-a11y"],
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "react/react-in-jsx-scope": "off",
    "@typescript-eslint/no-redeclare": "off"
  }
}
